#!/usr/bin/env bash

# Windows-specific configure script.
# Keep the same overall structure as configure, but use Windows-safe
# tool discovery, path normalization, and CMake generator settings.

rscript="${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe"
rexe="${R_HOME}/bin${R_ARCH_BIN}/R.exe"

git_exe=`"${rscript}" -e "cat(Sys.which('git'))"`
if [ -z "${git_exe}" ]; then
    "${rscript}" -e 'if (!requireNamespace("git2r")) install.packages("git2r")'
    str="repo = git2r::init();"
    str="${str} if (length(git2r::commits(repo)) > 0) {"
    str="${str} x=git2r::sha(git2r::last_commit(repo)) } else {x = ''};"
    str="${str} cat(x)"
    antsrtag=`"${rscript}" -e "${str}"`
else
    antsrtag=`git log --pretty=format:'%H' -n 1`
fi

CXX_STD=CXX17
CC=`"${rexe}" CMD config CC`
CXX=`"${rexe}" CMD config CXX`
JTHREADS=1

# Windows-specific linker flags that the package needs on Rtools.
ADD_PKG_LIBS="-lws2_32 -lgdi32 -mwindows -msse4.1 -mssse3"
TRY_LINKER_FLAGS="${ADD_PKG_LIBS} -Wl,--allow-multiple-definition -Wl,--enable-auto-import -Wl,--enable-runtime-pseudo-reloc -Wa,-mbig-obj"
DLLFLAGS="${DLLFLAGS} ${CMAKE_EXE_LINKER_FLAGS}"
PKG_CPPFLAGS="${PKG_CPPFLAGS} ${CMAKE_EXE_LINKER_FLAGS}"

ITKRCMAKE=`"${rscript}" -e 'a<-ITKR:::itkIncludes(); cat(a)'`
ITKRLIB=`"${rscript}" -e 'a<-ITKR:::itkLibs(); cat(a)'`
compflags=`"${rscript}" -e 'a<-ITKR:::itkCompileFlags(); cat(a)'`
ITKDIR=`"${rscript}" -e 'a<-ITKR:::itkDir(); if (length(a) && nzchar(a)) cat(normalizePath(a, winslash="/", mustWork=FALSE)) else cat("")'`
ITKTAG=`"${rscript}" -e 'env = asNamespace("ITKR"); if ("itkTag" %in% names(env)) cat(ITKR::itkTag()) else cat("")'`

CMAKE_BUILD_TYPE=Release

cd ./src
PWD=`"${rscript}" -e 'cat(normalizePath(".", winslash="/", mustWork=FALSE))'`

# platform-specific Makevars
echo "PWD=${PWD}" > Makevars.win
echo "myantssource=\${PWD}/ants" >> Makevars.win
echo "ITK=${ITKRCMAKE}" >> Makevars.win

echo "PKG_CPPFLAGS =${PKG_CPPFLAGS} -Wa,-mbig-obj -I\${ITK} -I\${PWD} -I\${myantssource}/Examples/include/ \
  -I\${myantssource}/Utilities -I\${myantssource}/Examples/ -I../inst/include/ \
  -I\${myantssource}/Tensor/ " >> Makevars.win

echo "CXX_STD=${CXX_STD}" >> Makevars.win
echo "SHLIB_CXXLD=${CMAKE_EXE_LINKER_FLAGS}" >> Makevars.win
echo "myantslib=\${PWD}/antb/lib/" >> Makevars.win
echo "antsexdir=\${PWD}/antb/ANTS-build/Examples/" >> Makevars.win

str="x = list.files(pattern = 'lib.*.a', path='"
str="${str}${ITKRLIB}'"
str="${str}); x = sub('[.]a$', '', x); x = sub('^lib', '', x); cat(paste0('-l', x), sep = ' ')"
libitk=`"${rscript}" -e "${str}"`
libitk="-L${ITKRLIB} ${libitk}"

# ANTs Windows library names are not discovered with find(), so keep the
# explicit list that matches the Windows build layout.
libants="-L${PWD}/antb/lib/ -L${PWD}/antb/ANTS-build/Examples/ -lantsUtilities -ll_antsAffineInitializer -ll_antsApplyTransforms "
libants="${libants} -ll_antsApplyTransformsToPoints -ll_antsJointFusion -ll_antsMotionCorr "
libants="${libants} -ll_antsMotionCorrStats -ll_antsRegistration -ll_Atropos -ll_DenoiseImage "
libants="${libants} -ll_KellyKapowski -ll_LabelClustersUniquely -ll_LabelGeometryMeasures "
libants="${libants} -ll_N3BiasFieldCorrection -ll_N4BiasFieldCorrection -ll_ResampleImage "
libants="${libants} -ll_sccan -ll_SurfaceBasedSmoothing -ll_ThresholdImage "

echo "PKG_LIBS=${PKG_LIBS} ${ADD_PKG_LIBS} ${libitk} ${libants} ${libitk} ${libants} " >> Makevars.win

echo ".PHONY: all libs" >> Makevars.win
echo "all: \$(SHLIB)" >> Makevars.win
echo "\$(SHLIB): libs" >> Makevars.win

echo 'libs:' >> Makevars.win
echo '	mkdir -p libs' >> Makevars.win
echo '	ls -la antb' >> Makevars.win
echo '	make -C antb -j 4' >> Makevars.win
echo '	ls -la antb/ANTS-build' >> Makevars.win
echo '	make -C antb/ANTS-build install' >> Makevars.win
echo "	rm -rf ${R_PACKAGE_DIR}/libs/bin" >> Makevars.win
echo '	cd ../../' >> Makevars.win

echo "cleaner: ; cd ../libs/bin && rm -f antsRegistration antsApplyTransforms antsMotionCorr \
antsAffineInitializer antsApplyTransformsToPoints LabelGeometryMeasures \
antsMotionCorrStats ResampleImage Atropos KellyKapowski DenoiseImage \
N3BiasFieldCorrection N4BiasFieldCorrection sccan antsJointFusion \
ThresholdImage LabelClustersUniquely SurfaceBasedSmoothing" >> Makevars

# get / set up ANTs code
# Keep the same upstream ANTs pin as configure; only the Windows fetch/build
# mechanics differ here.
antsgit=https://github.com/ANTsX/ANTs.git
antstag=516d24180390dd3bb18c6a507bc1651b5a183b85 # 2025-05-09 PPD in aat

if [ -z "${git_exe}" ]; then
    "${rscript}" -e 'if (!requireNamespace("git2r")) install.packages("git2r")'
    str="repo = git2r::clone(\""
    str="${str}${antsgit}"
    str="${str}\", local_path = \"./ants\")"
    "${rscript}" -e "${str}"
else
    git clone "$antsgit" ants
fi

mkdir -p ../data

cd ants

if [ -z "${git_exe}" ]; then
    "${rscript}" -e 'if (!requireNamespace("git2r")) install.packages("git2r")'
    str="repo = git2r::init()"
    if [ -n "${antstag}" ]; then
        str="${str}; git2r::checkout(repo, branch = \""
        str="${str}${antstag}"
        str="${str}\");"
    fi
    "${rscript}" -e "${str}"
else
    git checkout master
    git pull
    git checkout $antstag
fi

# Windows workaround for a warning in the ANTs CMake helpers.
if [ -a "./CMake/ITKSetStandardCompilerFlags.cmake" ]; then
    echo "working on ITKSetStandardCompilerFlags.cmake"
    str='fname="./CMake/ITKSetStandardCompilerFlags.cmake";'
    str=${str}'if (file.exists(fname)) {x=readLines(fname); '
    str=${str}'x = sub("VerboseWarningsFlag -W3", "VerboseWarningsFlag ", x); '
    str=${str}'writeLines(x, fname)}'
    "${rscript}" -e "${str}"
fi

cd ../
mkdir -p antb
cp ../inst/include/antscore.h ./ants/Examples/include/ants.h
cp -r ants/Examples/include/* ../inst/include/
cp -r ants/Utilities/* ../inst/include/
cp -r ants/Examples/* ../inst/include/
cp -r ants/Tensor/* ../inst/include/
cp -r ants/ImageRegistration/* ../inst/include/
cp -r ants/ImageSegmentation/* ../inst/include/
cp -r ants/Temporary/* ../inst/include

# ITK 6 requires semicolons after several ITK macro declarations. The ANTs
# headers copied into inst/include still use the older style, so patch them
# in place before we compile on Windows.
"${rscript}" -e '
fix_macros <- function(path) {
  lines <- readLines(path, warn = FALSE)
  pat <- "^[[:space:]]*itk(?:TypeMacro|SetStringMacro|GetStringMacro|SetMacro|GetMacro|GetConstMacro|BooleanMacro|SetClampMacro)\\(.*\\)[[:space:]]*$"
  idx <- grepl(pat, lines) & !grepl(";[[:space:]]*$", lines)
  lines[idx] <- sub("\\)[[:space:]]*$", ");", lines[idx])
  writeLines(lines, path)
}

files <- c(
  "../inst/include/antsCommandLineOption.h",
  "../inst/include/antsCommandLineParser.h",
  "../inst/include/itkLabeledPointSetFileReader.h",
  "../inst/include/itkLabeledPointSetFileWriter.h",
  "../inst/include/itkImageIntensityAndGradientToPointSetFilter.h",
  "../inst/include/itkLogTensorImageFilter.h"
)
for (f in files) {
  if (file.exists(f)) fix_macros(f)
}
'

cd ./antb

cmake_real=`"${rscript}" -e "x=Sys.which('cmake'); if (length(x) && nzchar(x)) cat(normalizePath(x, winslash='/', mustWork=FALSE)) else cat('')"`
if [ -z "${cmake_real}" ]; then
    res=`"${rscript}" -e "cat(('cmaker' %in% installed.packages())*1)"`
    if [ $res -eq 0 ]; then
        git clone https://github.com/stnava/cmaker
        R CMD INSTALL cmaker
        rm -rf cmaker
    fi
    cmake_real=`"${rscript}" -e "x=cmaker::cmake(); if (length(x) && nzchar(x)) cat(normalizePath(x, winslash='/', mustWork=FALSE)) else cat('')"`
fi

antbdir=`"${rscript}" -e 'cat(normalizePath(".", winslash="/", mustWork=FALSE))'`
cmakewrap="${antbdir}/cmake.exe"
cpackwrap="${antbdir}/cpack.exe"
ctestwrap="${antbdir}/ctest.exe"
cp -f "${cmake_real}" "${cmakewrap}"
cp -f "${cmake_real%cmake.exe}cpack.exe" "${cpackwrap}"
cp -f "${cmake_real%cmake.exe}ctest.exe" "${ctestwrap}"

cmaker="${cmakewrap}"

echo ${cmaker}

"${cmaker}" \
    -G "MinGW Makefiles" \
    -DITK_DIR:PATH="${ITKDIR}" \
    -DCMAKE_SH:BOOL=OFF \
    -DCMAKE_C_FLAGS="${CMAKE_C_FLAGS} -Wa,-mbig-obj ${CMAKE_EXE_LINKER_FLAGS} ${compflags} -DNDEBUG -D_FILE_OFFSET_BITS=64" \
    -DCMAKE_CXX_FLAGS="${CMAKE_CXX_FLAGS} -Wa,-mbig-obj ${compflags} -DNDEBUG" \
    -DCMAKE_EXE_LINKER_FLAGS="${TRY_LINKER_FLAGS}" \
    -DBUILD_SHARED_LIBS=OFF \
    -DANTS_INSTALL_LIBS_ONLY=ON \
    -DBUILD_ALL_ANTS_APPS=OFF \
    -DUSE_SYSTEM_ITK=OFF \
    -DBUILD_TESTING=OFF \
    -DBUILD_EXAMPLES:BOOL=OFF \
    -DCMAKE_NEED_RESPONSE=1 \
    -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON \
    -DCOPY_SCRIPT_FILES_TO_BIN_DIR=OFF \
    -DCMAKE_CPACK_COMMAND:FILEPATH="${cpackwrap}" \
    -DCMAKE_CTEST_COMMAND:FILEPATH="${ctestwrap}" \
    -DCMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE="../ants/lib/" \
    -DCMAKE_INSTALL_PREFIX:PATH="${R_PACKAGE_DIR}/libs/" \
    -DCMAKE_BUILD_TYPE:STRING="${CMAKE_BUILD_TYPE}" \
    ../ants

cd ../
# needed for warning
rm -rf ants/.git
